# Copy to .env and fill values
AI_SERVICE_NAME=smart-dental-ai
AI_SERVICE_PORT=8000

# openai | gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: shared secret so NestJS can call this service
AI_SERVICE_API_KEY=dev-local-key
