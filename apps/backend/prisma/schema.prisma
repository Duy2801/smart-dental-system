generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum AvailabilityRecordType {
  WEEKLY
  DATE_OVERRIDE
  TIME_OFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum BookingSource {
  PATIENT_APP
  WEBSITE
  RECEPTIONIST
  AI
  OTHER
}

enum DepositCalculationMode {
  PERCENT
  FIXED
}

enum AppointmentPaymentOption {
  DEPOSIT_30_PERCENT
  PAY_AT_COUNTER
}

enum AppointmentPaymentStatus {
  NOT_SELECTED
  PENDING_DEPOSIT
  DEPOSIT_PAID
  PAY_AT_COUNTER_SELECTED
  COUNTER_PAID
  WAIVED
}

enum TreatmentPlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SchedulePaymentOption {
  DEPOSIT_30_PERCENT
  PAY_AT_COUNTER
}

enum SchedulePaymentStatus {
  NOT_SELECTED
  PENDING_DEPOSIT
  DEPOSIT_PAID
  PAY_AT_COUNTER_SELECTED
  COUNTER_PAID
  WAIVED
}

enum TreatmentStepStatus {
  PLANNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentStepPaymentStatus {
  UNBILLED
  INVOICED
  PARTIALLY_PAID
  PAID
  WAIVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum InvoiceType {
  SERVICE
  DEPOSIT
  STEP_PAYMENT
  FINAL_PAYMENT
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
  ONLINE_GATEWAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ESCALATED
}

enum VideoConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
  CANCELLED
}

model ClinicConfig {
  id          String    @id @default(uuid()) @db.Uuid
  configType  String    @map("config_type")
  configKey   String    @unique @map("config_key")
  configValue String    @map("config_value") @db.Text
  configDate  DateTime? @map("config_date") @db.Date
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([configType])
  @@map("clinic_config")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String?    @map("password_hash")
  googleId      String?    @unique @map("google_id")
  phone         String?    @unique
  fullName      String     @map("full_name")
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false) @map("email_verified")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  patientProfile      Patient?
  doctorProfile       Doctor?
  roles               UserRole[]     @relation("UserRoleMemberships")
  assignedRoles       UserRole[]     @relation("UserRoleAssignments")
  createdAppointments Appointment[]  @relation("AppointmentCreator")
  createdInvoices     Invoice[]      @relation("InvoiceCreator")
  receivedPayments    Payment[]      @relation("PaymentReceiver")
  notifications       Notification[]

  @@index([fullName])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  module      String
  action      String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user     User  @relation("UserRoleMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("UserRoleAssignments", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedBy])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  category         String
  name             String
  slug             String?  @unique
  icon             String?  @map("icon")
  shortDescription String?  @map("short_description") @db.Text
  description      String?  @db.Text
  detailSummary    String?  @map("detail_summary") @db.Text
  thumbnailUrl     String?  @map("thumbnail_url")
  durationMinutes  Int      @map("duration_minutes")
  basePrice        Decimal  @map("base_price") @db.Decimal(12, 2)
  highlights       Json?
  suitableFor      Json?    @map("suitable_for")
  includedItems    Json?    @map("included_items")
  preparationNotes Json?    @map("preparation_notes")
  aftercareNotes   Json?    @map("aftercare_notes")
  importantNotes   Json?    @map("important_notes")
  pricingNote      String?  @map("pricing_note") @db.Text
  isFeatured       Boolean  @default(false) @map("is_featured")
  displayOrder     Int      @default(0) @map("display_order")
  isActive         Boolean  @default(true) @map("is_active")
  depositOverrideEnabled Boolean @default(false) @map("deposit_override_enabled")
  depositRequired  Boolean  @default(true) @map("deposit_required")
  depositCalculationMode  DepositCalculationMode? @map("deposit_calculation_mode")
  depositValue     Decimal? @map("deposit_value") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  treatmentMethods TreatmentMethod[]
  appointments     Appointment[]
  clinicalCases    ClinicalCase[]

  @@index([category, isActive])
  @@index([isFeatured, displayOrder])
  @@map("services")
}

model TreatmentMethod {
  id              String   @id @default(uuid()) @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  name            String
  slug            String?  @unique
  description     String?  @db.Text
  basePrice       Decimal  @map("base_price") @db.Decimal(12, 2)
  durationMinutes Int?     @map("duration_minutes")
  displayOrder    Int      @default(0) @map("display_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  service        Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  media          ServiceMedia[]
  procedureSteps ServiceProcedureStep[]
  faqs           ServiceFaq[]
  appointments   Appointment[]

  @@index([serviceId, isActive])
  @@map("treatment_methods")
}

model ServiceMedia {
  id                String   @id @default(uuid()) @db.Uuid
  treatmentMethodId String   @map("treatment_method_id") @db.Uuid
  url               String
  alt               String?
  type              String
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")

  treatmentMethod TreatmentMethod @relation(fields: [treatmentMethodId], references: [id], onDelete: Cascade)

  @@index([treatmentMethodId, sortOrder])
  @@map("service_media")
}

model ServiceProcedureStep {
  id                String @id @default(uuid()) @db.Uuid
  treatmentMethodId String @map("treatment_method_id") @db.Uuid
  stepOrder         Int    @map("step_order")
  title             String
  description       String @db.Text
  durationMinutes   Int?   @map("duration_minutes")

  treatmentMethod TreatmentMethod @relation(fields: [treatmentMethodId], references: [id], onDelete: Cascade)

  @@unique([treatmentMethodId, stepOrder])
  @@index([treatmentMethodId])
  @@map("service_procedure_steps")
}

model ServiceFaq {
  id                String @id @default(uuid()) @db.Uuid
  treatmentMethodId String @map("treatment_method_id") @db.Uuid
  question          String
  answer            String @db.Text
  sortOrder         Int    @default(0) @map("sort_order")

  treatmentMethod TreatmentMethod @relation(fields: [treatmentMethodId], references: [id], onDelete: Cascade)

  @@index([treatmentMethodId, sortOrder])
  @@map("service_faqs")
}

model Promotion {
  id                    String       @id @default(uuid()) @db.Uuid
  code                  String       @unique
  name                  String
  description           String?      @db.Text
  imageUrl              String?      @map("image_url") @db.Text
  applicableServiceSlug String?      @map("applicable_service_slug")
  discountType          DiscountType @map("discount_type")
  discountValue         Decimal      @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount        Decimal      @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxUses               Int?         @map("max_uses")
  usedCount             Int          @default(0) @map("used_count")
  startDate             DateTime     @map("start_date")
  endDate               DateTime     @map("end_date")
  isActive              Boolean      @default(true) @map("is_active")
  createdAt             DateTime     @default(now()) @map("created_at")

  invoices Invoice[]

  @@index([isActive, startDate, endDate])
  @@map("promotions")
}

model Patient {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  patientCode           String    @unique @map("patient_code")
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  gender                Gender    @default(UNKNOWN)
  address               String?   @db.Text
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  medicalHistory        String?   @map("medical_history") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments         Appointment[]
  clinicalCases        ClinicalCase[]
  medicalRecords       MedicalRecord[]
  treatmentPlans       TreatmentPlan[]
  prescriptions        Prescription[]
  invoices             Invoice[]
  reviews              Review[]
  chatbotConversations ChatbotConversation[]
  videoConsultations   VideoConsultation[]

  @@map("patients")
}

model Doctor {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  doctorCode      String   @unique @map("doctor_code")
  specialization  String
  licenseNumber   String   @unique @map("license_number")
  avatarUrl       String?  @map("avatar_url") @db.Text
  bio             String?  @db.Text
  position        String?
  workplace       String?
  yearsExperience Int      @default(0) @map("years_experience")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability       DoctorAvailability[]
  appointments       Appointment[]
  certificates       DoctorCertificate[]
  clinicalCases      ClinicalCase[]
  educations         DoctorEducation[]
  media              DoctorMedia[]
  medicalRecords     MedicalRecord[]
  treatmentPlans     TreatmentPlan[]
  treatmentPlanSteps TreatmentPlanStep[]
  prescriptions      Prescription[]
  reviews            Review[]
  videoConsultations VideoConsultation[]

  @@index([specialization, isActive])
  @@map("doctors")
}

model DoctorEducation {
  id             String  @id @default(uuid()) @db.Uuid
  doctorId       String  @map("doctor_id") @db.Uuid
  degree         String
  school         String
  major          String?
  graduationYear Int?    @map("graduation_year")
  description    String? @db.Text
  sortOrder      Int     @default(0) @map("sort_order")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, degree, school])
  @@index([doctorId, sortOrder])
  @@map("doctor_educations")
}

model DoctorCertificate {
  id             String    @id @default(uuid()) @db.Uuid
  doctorId       String    @map("doctor_id") @db.Uuid
  title          String
  issuer         String
  issuedAt       DateTime? @map("issued_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  certificateUrl String?   @map("certificate_url") @db.Text
  imageUrl       String?   @map("image_url") @db.Text
  description    String?   @db.Text
  sortOrder      Int       @default(0) @map("sort_order")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, title, issuer])
  @@index([doctorId, sortOrder])
  @@map("doctor_certificates")
}

model DoctorMedia {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  url       String   @db.Text
  alt       String?
  type      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, sortOrder])
  @@map("doctor_media")
}

model DoctorAvailability {
  id           String                 @id @default(uuid()) @db.Uuid
  doctorId     String                 @map("doctor_id") @db.Uuid
  recordType   AvailabilityRecordType @map("record_type")
  dayOfWeek    Int?                   @map("day_of_week")
  specificDate DateTime?              @map("specific_date") @db.Date
  startTime    String                 @map("start_time")
  endTime      String                 @map("end_time")
  reason       String?                @db.Text
  isActive     Boolean                @default(true) @map("is_active")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
  @@index([doctorId, specificDate])
  @@map("doctor_availability")
}

model Appointment {
  id                  String                    @id @default(uuid()) @db.Uuid
  appointmentCode     String                    @unique @map("appointment_code")
  patientId           String?                   @map("patient_id") @db.Uuid
  doctorId            String                    @map("doctor_id") @db.Uuid
  serviceId           String                    @map("service_id") @db.Uuid
  treatmentMethodId   String?                   @map("treatment_method_id") @db.Uuid
  treatmentPlanStepId String?                   @map("treatment_plan_step_id") @db.Uuid
  scheduledAt         DateTime                  @map("scheduled_at")
  endAt               DateTime                  @map("end_at")
  status              AppointmentStatus         @default(PENDING)
  bookingSource       BookingSource             @map("booking_source")
  paymentOption       AppointmentPaymentOption? @map("payment_option")
  paymentStatus       AppointmentPaymentStatus  @default(NOT_SELECTED) @map("payment_status")
  depositPercent      Decimal                   @default(30.00) @map("deposit_percent") @db.Decimal(5, 2)
  depositAmount       Decimal?                  @map("deposit_amount") @db.Decimal(12, 2)
  scheduleConfirmedAt DateTime?                 @map("schedule_confirmed_at")
  aiSuggestedTime     DateTime?                 @map("ai_suggested_time")
  notes               String?                   @db.Text
  rescheduleHistory   Json?                     @map("reschedule_history")
  cancellationReason  String?                   @map("cancellation_reason") @db.Text
  cancelledAt         DateTime?                 @map("cancelled_at")
  checkedInAt         DateTime?                 @map("checked_in_at")
  completedAt         DateTime?                 @map("completed_at")
  createdBy           String                    @map("created_by") @db.Uuid
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  patient           Patient?           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor            Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  service           Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  treatmentMethod   TreatmentMethod?   @relation(fields: [treatmentMethodId], references: [id], onDelete: SetNull)
  treatmentPlanStep TreatmentPlanStep? @relation(fields: [treatmentPlanStepId], references: [id], onDelete: SetNull)
  creator           User               @relation("AppointmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  clinicalCases     ClinicalCase[]
  medicalRecords    MedicalRecord[]
  invoices          Invoice[]
  reviews           Review[]
  notifications     Notification[]

  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([paymentStatus])
  @@index([serviceId])
  @@index([treatmentMethodId])
  @@index([treatmentPlanStepId])
  @@index([createdBy])
  @@map("appointments")
}

model MedicalRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  appointmentId       String    @map("appointment_id") @db.Uuid
  doctorId            String    @map("doctor_id") @db.Uuid
  treatmentPlanStepId String?   @map("treatment_plan_step_id") @db.Uuid
  chiefComplaint      String?   @map("chief_complaint") @db.Text
  diagnosis           String?   @db.Text
  treatmentNotes      String?   @map("treatment_notes") @db.Text
  internalNotes       String?   @map("internal_notes") @db.Text
  followUpDate        DateTime? @map("follow_up_date") @db.Date
  dentalChart         Json?     @map("dental_chart")
  images              Json?
  prescriptions       Json?
  exportPdfUrl        String?   @map("export_pdf_url")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment         Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  clinicalCases       ClinicalCase[]
  doctor              Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  treatmentPlanStep   TreatmentPlanStep? @relation(fields: [treatmentPlanStepId], references: [id], onDelete: SetNull)
  prescriptionRecords Prescription[]

  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([doctorId])
  @@index([treatmentPlanStepId])
  @@map("medical_records")
}

model TreatmentPlan {
  id                    String                 @id @default(uuid()) @db.Uuid
  patientId             String                 @map("patient_id") @db.Uuid
  doctorId              String                 @map("doctor_id") @db.Uuid
  title                 String
  description           String?                @db.Text
  status                TreatmentPlanStatus    @default(PLANNED)
  startDate             DateTime?              @map("start_date") @db.Date
  expectedEndDate       DateTime?              @map("expected_end_date") @db.Date
  schedulePaymentOption SchedulePaymentOption? @map("schedule_payment_option")
  schedulePaymentStatus SchedulePaymentStatus  @default(NOT_SELECTED) @map("schedule_payment_status")
  depositPercent        Decimal                @default(30.00) @map("deposit_percent") @db.Decimal(5, 2)
  depositAmount         Decimal?               @map("deposit_amount") @db.Decimal(12, 2)
  scheduleConfirmedAt   DateTime?              @map("schedule_confirmed_at")
  items                 Json?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  steps         TreatmentPlanStep[]
  clinicalCases ClinicalCase[]
  invoices      Invoice[]
  notifications Notification[]

  @@index([patientId, status])
  @@index([doctorId])
  @@index([schedulePaymentStatus])
  @@map("treatment_plans")
}

model TreatmentPlanStep {
  id              String                     @id @default(uuid()) @db.Uuid
  treatmentPlanId String                     @map("treatment_plan_id") @db.Uuid
  doctorId        String                     @map("doctor_id") @db.Uuid
  stepOrder       Int                        @map("step_order")
  title           String
  description     String?                    @db.Text
  targetTooth     String?                    @map("target_tooth")
  status          TreatmentStepStatus        @default(PLANNED)
  estimatedCost   Decimal?                   @map("estimated_cost") @db.Decimal(12, 2)
  paymentAmount   Decimal?                   @map("payment_amount") @db.Decimal(12, 2)
  paymentStatus   TreatmentStepPaymentStatus @default(UNBILLED) @map("payment_status")
  paymentDueAt    DateTime?                  @map("payment_due_at")
  paidAt          DateTime?                  @map("paid_at")
  expectedDate    DateTime?                  @map("expected_date") @db.Date
  completedAt     DateTime?                  @map("completed_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  treatmentPlan  TreatmentPlan   @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  doctor         Doctor          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  invoices       Invoice[]

  @@unique([treatmentPlanId, stepOrder])
  @@index([doctorId])
  @@index([status, expectedDate])
  @@index([paymentStatus, paymentDueAt])
  @@map("treatment_plan_steps")
}

model ClinicalCase {
  id                   String   @id @default(uuid()) @db.Uuid
  patientId            String   @map("patient_id") @db.Uuid
  doctorId             String   @map("doctor_id") @db.Uuid
  serviceId            String   @map("service_id") @db.Uuid
  appointmentId        String   @map("appointment_id") @db.Uuid
  medicalRecordId      String   @map("medical_record_id") @db.Uuid
  treatmentPlanId      String?  @map("treatment_plan_id") @db.Uuid
  title                String
  description          String?  @db.Text
  treatmentDuration    String?  @map("treatment_duration")
  beforeImageUrl       String   @map("before_image_url") @db.Text
  afterImageUrl        String   @map("after_image_url") @db.Text
  patientConsentPublic Boolean  @default(false) @map("patient_consent_public")
  isPublished          Boolean  @default(false) @map("is_published")
  displayOrder         Int      @default(0) @map("display_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord  @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  treatmentPlan TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)

  @@index([isPublished, patientConsentPublic, displayOrder])
  @@index([patientId, createdAt])
  @@index([doctorId])
  @@index([serviceId])
  @@index([appointmentId])
  @@index([medicalRecordId])
  @@index([treatmentPlanId])
  @@map("clinical_cases")
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  invoiceCode         String        @unique @map("invoice_code")
  patientId           String        @map("patient_id") @db.Uuid
  appointmentId       String?       @map("appointment_id") @db.Uuid
  treatmentPlanId     String?       @map("treatment_plan_id") @db.Uuid
  treatmentPlanStepId String?       @map("treatment_plan_step_id") @db.Uuid
  promotionId         String?       @map("promotion_id") @db.Uuid
  invoiceType         InvoiceType   @default(SERVICE) @map("invoice_type")
  items               Json
  subtotal            Decimal       @db.Decimal(12, 2)
  discountAmount      Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount         Decimal       @map("final_amount") @db.Decimal(12, 2)
  status              InvoiceStatus @default(DRAFT)
  exportFileUrl       String?       @map("export_file_url")
  issuedAt            DateTime?     @map("issued_at")
  createdBy           String        @map("created_by") @db.Uuid

  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  treatmentPlan     TreatmentPlan?     @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  treatmentPlanStep TreatmentPlanStep? @relation(fields: [treatmentPlanStepId], references: [id], onDelete: SetNull)
  promotion         Promotion?         @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  creator           User               @relation("InvoiceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  payments          Payment[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([treatmentPlanId])
  @@index([treatmentPlanStepId])
  @@index([invoiceType])
  @@index([promotionId])
  @@index([status])
  @@index([createdBy])
  @@map("invoices")
}

model Prescription {
  id                  String   @id @default(uuid()) @db.Uuid
  medicalRecordId     String   @map("medical_record_id") @db.Uuid
  treatmentPlanStepId String?  @map("treatment_plan_step_id") @db.Uuid
  doctorId            String   @map("doctor_id") @db.Uuid
  patientId           String   @map("patient_id") @db.Uuid
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  medicalRecord     MedicalRecord      @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  treatmentPlanStep TreatmentPlanStep? @relation(fields: [treatmentPlanStepId], references: [id], onDelete: SetNull)
  doctor            Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items             PrescriptionItem[]

  @@index([medicalRecordId])
  @@index([treatmentPlanStepId])
  @@index([doctorId])
  @@index([patientId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid()) @db.Uuid
  prescriptionId String  @map("prescription_id") @db.Uuid
  medicineName   String  @map("medicine_name")
  dosage         String
  frequency      String?
  duration       String?
  instruction    String? @db.Text

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  transactionRef String?       @unique @map("transaction_ref")
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?     @map("paid_at")
  receivedBy     String        @map("received_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receiver User    @relation("PaymentReceiver", fields: [receivedBy], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@index([receivedBy])
  @@map("payments")
}

model Review {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  doctorId      String   @map("doctor_id") @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  rating        Int
  comment       String?  @db.Text
  isVisible     Boolean  @default(true) @map("is_visible")
  createdAt     DateTime @default(now()) @map("created_at")

  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@unique([patientId, appointmentId])
  @@index([doctorId, isVisible])
  @@index([appointmentId])
  @@map("reviews")
}

model ChatbotConversation {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @unique @map("session_id")
  patientId String             @map("patient_id") @db.Uuid
  status    ConversationStatus @default(ACTIVE)
  messages  Json
  startedAt DateTime           @default(now()) @map("started_at")
  endedAt   DateTime?          @map("ended_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, startedAt])
  @@map("chatbot_conversations")
}

model VideoConsultation {
  id              String                  @id @default(uuid()) @db.Uuid
  patientId       String                  @map("patient_id") @db.Uuid
  doctorId        String                  @map("doctor_id") @db.Uuid
  scheduledAt     DateTime                @map("scheduled_at")
  durationMinutes Int                     @map("duration_minutes")
  status          VideoConsultationStatus @default(SCHEDULED)
  meetingUrl      String?                 @map("meeting_url")
  fee             Decimal                 @db.Decimal(12, 2)
  isPaid          Boolean                 @default(false) @map("is_paid")
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("video_consultations")
}

model Notification {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  type            String
  title           String
  content         String              @db.Text
  channel         NotificationChannel
  status          NotificationStatus  @default(PENDING)
  scheduledAt     DateTime?           @map("scheduled_at")
  appointmentId   String?             @map("appointment_id") @db.Uuid
  treatmentPlanId String?             @map("treatment_plan_id") @db.Uuid
  isManual        Boolean             @default(false) @map("is_manual")
  sentAt          DateTime?           @map("sent_at")
  readAt          DateTime?           @map("read_at")
  createdAt       DateTime            @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  treatmentPlan TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, readAt])
  @@index([scheduledAt, status])
  @@index([appointmentId])
  @@index([treatmentPlanId])
  @@map("notifications")
}
